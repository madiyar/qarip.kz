---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import FontBrowser from '../components/fonts/FontBrowser';
import { type Lang, localePath, useT } from '../i18n';
import { getCategories, getFonts, primaryFaces, toSummaries } from '../lib/fonts';
import { CATALOG, CATEGORY, breadcrumbLd, categoryTitle, itemListLd } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Static category page (/fonts/category/<id>). */
  category?: string;
}
const { lang, category } = Astro.props;
const t = useT(lang);
const all = await toSummaries(await getFonts(), lang);
const categories = await getCategories(lang);
const purposes = (await getCollection('purposes')).map((x) => ({ id: x.id, name: x.data.name }));

const cat = categories.find((c) => c.id === category);
const fonts = cat ? all.filter((f) => f.category.id === cat.id) : all;

const catName = cat ? (CATEGORY[cat.id]?.name[lang] ?? cat.label) : '';
const title = cat ? categoryTitle(lang, cat.id, cat.name) : CATALOG.title[lang];
const catText = cat ? (CATEGORY[cat.id]?.description[lang] ?? t(cat.description)) : '';
const catOffer = { kk: `Қазақ әріптері бар ${fonts.length} шрифт — тегін жүктеу.`, ru: `Шрифтов с казахскими буквами: ${fonts.length} — скачать бесплатно.`, en: `${fonts.length} fonts with Kazakh letters — free download.` }[lang];
const description = cat ? `${catText} ${catOffer}` : CATALOG.description[lang];
const h1 = cat ? catName : t('Қаріптер');
const lead = cat ? catText : t('Барлығы тегін жүктеледі, әрқайсысы қазақ әріптеріне тексерілген.');
const countIn = (id: string) => all.filter((f) => f.category.id === id).length;

const site = Astro.site!;
const crumbs = [
  { name: 'Qarip', path: localePath(lang, '/') },
  { name: t('Қаріптер'), path: localePath(lang, '/fonts') },
  ...(cat ? [{ name: catName, path: localePath(lang, `/fonts/category/${cat.id}`) }] : []),
];
---

<Base lang={lang} fullTitle={`${title} | Qarip`} description={description} fontCss={primaryFaces(fonts)} noindex={Boolean(cat) && fonts.length === 0}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListLd(site, lang, h1, fonts))} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd(site, crumbs))} />

  {cat && <Breadcrumbs class="mb-2.5" label={t('Жол')} items={[{ label: t('Қаріптер'), href: localePath(lang, '/fonts') }, { label: cat.label }]} />}
  <PageHeader title={h1} count={fonts.length} description={lead} class="!mb-5" />

  <!-- Categories are static pages (for search engines), drawn as pills. -->
  <nav class="no-scrollbar -mx-4 mb-3 flex gap-1 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0" aria-label={t('Категориялар')}>
    <a href={localePath(lang, '/fonts')} class="pill" aria-current={!cat ? 'page' : undefined}>
      {t('Барлығы')}
    </a>
    {
      categories.map((c) => (
        <a href={localePath(lang, `/fonts/category/${c.id}`)} class="pill" aria-current={cat?.id === c.id ? 'page' : undefined}>
          {c.label}
          <span class="text-xs opacity-60 tabular-nums">{countIn(c.id)}</span>
        </a>
      ))
    }
  </nav>

  <FontBrowser client:load fonts={fonts} purposes={purposes} perPage={100} lang={lang} filters syncUrl prefKey="catalog" />

  <p class="mt-10 text-sm text-fg-3">
    {t('Керек қаріп табылмады ма? Сүйікті қаріпіңізге немесе брендіңіздің қаріпіне қазақ әріптерін')}
    <a class="link-quiet" href={localePath(lang, '/services')}>{t('қосып береміз')}</a>.
  </p>
</Base>
