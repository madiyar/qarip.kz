---
import Base from '../layouts/Base.astro';
import Catalog, { type CatalogSection } from '../components/fonts/Catalog';
import { type Lang, localePath, useT } from '../i18n';
import { getCategories, getFonts, getTerms, primaryFaces, toSummaries } from '../lib/fonts';
import { CATALOG, CATEGORY, breadcrumbLd, categoryTitle, itemListLd } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Static category page (/fonts/category/<id>). */
  category?: string;
}
const { lang, category } = Astro.props;
const t = useT(lang);
const all = await toSummaries(await getFonts(), lang);
const categories = await getCategories(lang);
const [purposes, tags] = await Promise.all([getTerms('purposes', lang), getTerms('tags', lang)]);

const cat = categories.find((c) => c.id === category);
const fonts = cat ? all.filter((f) => f.category.id === cat.id) : all;

// Every section of the catalog, so the island can switch between them without a reload.
const sections: CatalogSection[] = [
  {
    id: '',
    label: t('Барлығы'),
    href: localePath(lang, '/fonts'),
    title: `${CATALOG.title[lang]} | Qarip`,
    h1: t('Қаріптер'),
    lead: t('Барлығы тегін жүктеледі, әрқайсысы қазақ әріптеріне тексерілген.'),
  },
  ...categories.map((c) => ({
    id: c.id,
    label: c.label,
    href: localePath(lang, `/fonts/category/${c.id}`),
    title: `${categoryTitle(lang, c.id, c.name)} | Qarip`,
    h1: CATEGORY[c.id]?.name[lang] ?? c.label,
    lead: CATEGORY[c.id]?.description[lang] ?? t(c.description),
  })),
];
const section = sections.find((s) => s.id === (cat?.id ?? '')) ?? sections[0];

const catOffer = { kk: `Қазақ әріптері бар ${fonts.length} шрифт — тегін жүктеу.`, ru: `Шрифтов с казахскими буквами: ${fonts.length} — скачать бесплатно.`, en: `${fonts.length} fonts with Kazakh letters — free download.` }[lang];
const description = cat ? `${section.lead} ${catOffer}` : CATALOG.description[lang];

const site = Astro.site!;
const crumbs = [
  { name: 'Qarip', path: localePath(lang, '/') },
  { name: t('Қаріптер'), path: localePath(lang, '/fonts') },
  ...(cat ? [{ name: section.h1, path: section.href }] : []),
];
---

<Base lang={lang} fullTitle={section.title} description={description} fontCss={primaryFaces(all)} noindex={Boolean(cat) && fonts.length === 0}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListLd(site, lang, section.h1, fonts))} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd(site, crumbs))} />

  <Catalog client:load lang={lang} fonts={all} purposes={purposes} tags={tags} sections={sections} current={cat?.id ?? ''} />

  <p class="mt-10 text-sm text-fg-3">
    {t('Керек қаріп табылмады ма? Сүйікті қаріпіңізге немесе брендіңіздің қаріпіне қазақ әріптерін')}
    <a class="link-quiet" href={localePath(lang, '/services')}>{t('қосып береміз')}</a>.
  </p>
</Base>
