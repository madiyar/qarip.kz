---
/** "Fonts / Serif" trail above a page title. The last item is the current page (no link). */
interface Props {
  items: { label: string; href?: string }[];
  label: string;
  class?: string;
}
const { items, label, class: className } = Astro.props;
---

<nav aria-label={label} class:list={['flex flex-wrap gap-1.5 text-[13px] text-fg-3', className]}>
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-accent-ink">
            {item.label}
          </a>
        ) : (
          <span class="text-fg-2" aria-current="page">
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>
