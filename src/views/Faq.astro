---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Accordion from '../components/common/Accordion.astro';
import Icon from '../components/ui/Icon';
import { type Lang, localePath, useT } from '../i18n';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

/** Groups of questions (`category` in src/content/faq.json, a select in the CMS). */
const CATEGORIES = [
  ['install', 'Орнату'],
  ['license', 'Лицензия'],
  ['fonts', 'Қаріптер'],
  ['site', 'Сайт'],
] as const;

// Internal links inside answers must follow the current locale.
const localize = (html: string) => html.replace(/href="(\/[^"]*)"/g, (_, p) => `href="${localePath(lang, p)}"`);
// Edited in the CMS (Анықтамалықтар → F.A.Q.); a missing translation falls back to Kazakh.
const faq = (await getCollection('faq'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map(({ data: d }) => ({
    cat: d.category,
    q: { kk: d.question, ru: d.questionRu, en: d.questionEn }[lang] || d.question,
    html: localize(marked.parse({ kk: d.answer, ru: d.answerRu, en: d.answerEn }[lang] || d.answer, { async: false })),
  }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.html } })),
};
const cats = CATEGORIES.filter(([id]) => faq.some((f) => f.cat === id));
---

<Base lang={lang} title={`F.A.Q. — ${t('Жиі қойылатын сұрақтар')}`} description={t('Жүктеу, орнату, лицензия және қазақ әріптері туралы.')}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div>
    <PageHeader size="lg" title="F.A.Q." description={t('Жүктеу, орнату, лицензия және қазақ әріптері туралы.')} />
    <div role="tablist" aria-label={t('Тақырып')} class="no-scrollbar -mx-4 mb-[18px] flex gap-1.5 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0" data-faq-cats>
      <button type="button" role="tab" aria-selected="true" class="pill px-4" data-cat="">{t('Барлығы')}</button>
      {
        cats.map(([id, label]) => (
          <button type="button" role="tab" aria-selected="false" class="pill px-4" data-cat={id}>
            {t(label)}
          </button>
        ))
      }
    </div>
    <div data-faq-list>
      <Accordion items={faq.map((f) => ({ title: f.q, html: f.html, group: f.cat }))} />
    </div>

    <div class="note mt-7 flex flex-wrap items-center justify-between gap-3.5 px-6 py-[22px]">
      <div>
        <b class="font-semibold">{t('Жауап таппадыңыз ба?')}</b>
        <p class="sub">
          {t('Telegram-ға немесе поштаға жазыңыз:')} <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>
      <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="btn-primary btn-sm h-[42px]!">
        <Icon name="send" size={16} />
        {t('Telegram-ға жазу')}
      </a>
    </div>
  </div>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-faq-cats] [data-cat]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-faq-list] details')];
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat;
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
      for (const el of items) el.hidden = Boolean(cat) && el.dataset.group !== cat;
    });
  }
</script>
