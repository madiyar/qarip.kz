---
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, href, linkLabel } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
  </div>
  {
    href && (
      <a href={href} class="group flex items-center gap-1 text-sm font-semibold whitespace-nowrap text-muted hover:text-fg">
        {linkLabel}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    )
  }
</div>
