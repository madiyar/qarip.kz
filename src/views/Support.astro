---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import ShareButton from '../components/common/ShareButton';
import CopyButton from '../components/ui/CopyButton';
import Icon from '../components/ui/Icon';
import { type Lang, localePath, useT } from '../i18n';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const siteUrl = SITE.url;
---

<Base lang={lang} title={t('Жобаны қолдау')} description={t('Qarip — тегін қазақ қаріп қоры. Жобаны дамыту үшін сіздің қолдауыңыз өте маңызды.')}>
  <PageHeader eyebrow={t('Қолдау')} title={t('Жобаны қолдап кетіңіз')} description={t('Qarip — тегін қазақ қаріп қоры. Жобаны дамыту үшін сіздің қолдауыңыз өте маңызды. Мүмкіндіктеріңізше өз үлесіңізді қосыңыз.')} />
  <div class="grid gap-4 md:grid-cols-2">
    <section class="card p-6">
      <span class="flex size-10 items-center justify-center rounded-xl bg-accent-soft text-accent"><Icon name="share" /></span>
      <h2 class="mt-4 text-xl font-bold">{t('Тарату')}</h2>
      <p class="mt-1 text-sm text-muted">{t('Сілтемені достарыңызбен бөлісіңіз')}</p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <code class="input flex items-center font-mono sm:w-auto">{siteUrl}</code>
        <ShareButton client:idle url={siteUrl} title="Qarip" label={t('Бөлісу')} copied={t('Көшірілді')} />
      </div>
    </section>
    <section class="card p-6">
      <span class="flex size-10 items-center justify-center rounded-xl bg-accent-soft text-accent"><Icon name="heart" /></span>
      <h2 class="mt-4 text-xl font-bold">{t('Жазылу & Лайк')}</h2>
      <p class="mt-1 text-sm text-muted">{t('Әлеуметтік желіде қолдаңыз')}</p>
      <div class="mt-5 grid gap-2 sm:grid-cols-2">
        <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-line p-4 hover:bg-surface-2">
          <span class="flex items-center gap-2 font-semibold"><Icon name="send" size={16} />Telegram</span>
          <span class="mt-1 block text-xs text-muted">{t('Жаңалықтарды бірінші болып алыңыз')}</span>
        </a>
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-line p-4 hover:bg-surface-2">
          <span class="flex items-center gap-2 font-semibold"><Icon name="instagram" size={16} />Instagram</span>
          <span class="mt-1 block text-xs text-muted">{t('Жобаның артқы сахнасы')}</span>
        </a>
      </div>
    </section>
    {
      SITE.donation.card && (
        <section class="card p-6">
          <span class="flex size-10 items-center justify-center rounded-xl bg-accent-soft text-accent"><Icon name="gift" /></span>
          <h2 class="mt-4 text-xl font-bold">{t('Донат')}</h2>
          <p class="mt-1 text-sm text-muted">{t('Картаға аудару арқылы қолдаңыз')}</p>
          <div class="mt-5 rounded-2xl bg-gradient-to-br from-accent to-indigo-700 p-5 text-white">
            <p class="text-sm text-white/70">{SITE.donation.bank}</p>
            <p class="mt-3 font-mono text-xl tracking-widest">{SITE.donation.card}</p>
            <p class="mt-2 text-sm text-white/80">{SITE.donation.holder}</p>
          </div>
          <div class="mt-3">
            <CopyButton client:idle text={SITE.donation.card.replace(/\s/g, '')} label={t('Карта нөмірін көшіру')} done={t('Көшірілді')} />
          </div>
        </section>
      )
    }
    <section class="card p-6">
      <span class="flex size-10 items-center justify-center rounded-xl bg-accent-soft text-accent"><Icon name="type" /></span>
      <h2 class="mt-4 text-xl font-bold">{t('Қаріп ұсыну')}</h2>
      <p class="mt-1 text-sm text-muted">{t('Қазақ әріптері бар қаріп жасадыңыз ба? Бізге жіберіңіз — қорға қосамыз.')}</p>
      <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Qarip: жаңа қаріп')}`} class="btn-secondary mt-5"><Icon name="mail" size={16} />{t('Жіберу')}</a>
    </section>
  </div>
  <p class="mt-10 text-center text-sm text-muted">
    {t('Қаріпке тапсырыс бергіңіз келе ме?')} <a class="link" href={localePath(lang, '/services')}>{t('Қызметтер')}</a>
  </p>
</Base>
