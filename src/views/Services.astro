---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Icon from '../components/ui/Icon';
import { type Lang, localePath, useT } from '../i18n';
import { SITE } from '../lib/site';
import { familyName, getFonts, primaryFaces, toSummaries } from '../lib/fonts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const services = [
  { title: 'Қазақ әріптерін қосу', text: 'Латын немесе кирилл қаріпке қазақ тіліне арналған әріптерді қосамыз', price: '10 000 ₸', list: ['Ә, Ғ, Қ, Ң, Ө, Ұ, Ү, Һ, І әріптері', 'Барлық начертаниялар', 'Кернинг реттеу', 'Сапа тексеру'], highlight: true },
  { title: 'Кирилл әріптерін жасау', text: 'Латын қаріпке толық кирилл алфавитін жасаймыз', price: '50 000 ₸', list: ['Толық кирилл алфавиті', 'Қазақ әріптерімен', 'Орыс тілі қолдауы', 'Профессионалды сапа'] },
  { title: 'Қаріпті реттеу', text: 'Бар қаріпті сіздің қажеттіліктеріңізге сәйкес өзгертеміз', price: '200 000 ₸', list: ['Өзгерістер енгізу', 'Стиль реттеу', 'Жаңа глифтар қосу', 'Кернинг оптимизациясы'] },
  { title: 'Жаңа қаріп жасау', text: 'Нөлден жаңа, уникалды қаріп жасаймыз', price: '500 000 ₸', list: ['Уникалды дизайн', 'Көп начертания', 'Барлық тілдер', 'Толық құжаттама'] },
];
const steps = ['Өтінім жіберу', 'Техникалық тапсырманы талқылау', 'Жұмыс және түзетулер', 'Дайын файлдарды тапсыру'];
const mail = (s: string) => `mailto:${SITE.email}?subject=${encodeURIComponent(`${t('Тапсырыс')}: ${t(s)}`)}`;
// Qarip's own fonts show the work.
const works = (await toSummaries((await getFonts()).filter((f) => f.data.our), lang)).slice(0, 7);
---

<Base lang={lang} title={t('Қаріп дизайн қызметтері')} description={t('Сүйікті қаріпке қазақ әріптерін қосамыз, латын қаріпке кирилл саламыз немесе брендке жаңа қаріп жасаймыз.')} fontCss={primaryFaces(works)}>
  <div class="mx-auto max-w-[1040px]">
    <PageHeader size="lg" title={t('Қаріп дизайн қызметтері')} description={t('Сүйікті қаріпке қазақ әріптерін қосамыз, латын қаріпке кирилл саламыз немесе брендке жаңа қаріп жасаймыз.')} class="!mb-10" />

    <section aria-label={t('Қызметтер мен бағалар')} class="panel mb-14 overflow-hidden !rounded-[22px]">
      {
        services.map((s) => (
          <a href={mail(s.title)} class="row-link flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-line px-6 py-[22px] last:border-0">
            <span class="flex min-w-0 flex-[1_1_300px] flex-col gap-1">
              <span class="flex flex-wrap items-center gap-2">
                <b class="text-lg font-semibold">{t(s.title)}</b>
                {s.highlight && <span class="rounded-full bg-accent-soft px-2 py-px text-xs font-semibold text-accent-ink">{t('Жиі сұралады')}</span>}
              </span>
              <span class="text-[15px] text-fg-2">{t(s.text)}</span>
              <span class="meta">{s.list.map((x) => t(x)).join(' · ')}</span>
            </span>
            <span class="flex min-w-[150px] flex-col gap-0.5 sm:items-end">
              <span class="text-[22px] font-[650] tracking-[-0.02em] tabular-nums">{s.price}</span>
              <span class="meta">{t('бастап')}</span>
              <span class="mt-1.5 text-sm font-semibold text-accent-ink">{t('Тапсырыс беру')} →</span>
            </span>
          </a>
        ))
      }
    </section>

    {
      works.length > 0 && (
        <section class="mb-14">
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <h2 class="title-md">{t('Жұмыстар')}</h2>
            <a class="link-more !text-accent-ink" href={localePath(lang, '/fonts?our=1')}>
              {t('Qarip қаріптері')} →
            </a>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(220px,1fr))]">
            {works.map((f) => (
              <a href={localePath(lang, `/fonts/${f.slug}`)} class="panel hover-name flex min-h-[170px] flex-col justify-between gap-6 p-[18px] transition-shadow hover:shadow-2">
                <span class="text-5xl leading-none text-fg" style={`font-family:'${familyName(f.slug)}', system-ui`}>
                  Ққ Әә
                </span>
                <span class="font-name text-sm font-normal text-fg-3">{f.name}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="mb-14">
      <h2 class="title-md mb-4">{t('Қалай жұмыс істейміз')}</h2>
      <ol class="grid gap-3 sm:grid-cols-[repeat(auto-fit,minmax(210px,1fr))]">
        {
          steps.map((s, i) => (
            <li class="panel flex flex-col gap-1.5 p-[18px]">
              <span class="text-[13px] font-semibold text-accent-ink">0{i + 1}</span>
              <b class="font-semibold">{t(s)}</b>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="panel flex flex-wrap items-center justify-between gap-x-12 gap-y-7 !rounded-3xl p-[clamp(24px,4vw,40px)]">
      <div class="max-w-[460px] flex-[1_1_320px]">
        <h2 class="text-[26px] font-[650] tracking-[-0.025em]">{t('Тапсырыс беру')}</h2>
        <p class="mt-2.5 leading-relaxed text-fg-2">{t('Қандай қаріп, қанша стиль және қашанға керек екенін бірнеше сөйлеммен жазыңыз — нақты баға мен мерзімді айтамыз.')}</p>
      </div>
      <div class="flex max-w-[400px] flex-[1_1_320px] flex-col gap-2">
        <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="flex h-14 items-center gap-3 rounded-2xl bg-accent px-[18px] text-on-accent transition-colors hover:bg-accent-hover">
          <Icon name="send" size={18} />
          <b class="flex-1 text-base font-semibold">{t('Telegram-ға жазу')}</b>
        </a>
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class="flex h-[52px] items-center gap-3 rounded-2xl bg-fill px-[18px] transition-colors hover:bg-fill-2">
          <span class="flex-1 font-medium">Instagram</span>
          <Icon name="external" size={15} className="text-fg-3" />
        </a>
        <a href={`mailto:${SITE.email}`} class="flex h-[52px] items-center gap-3 rounded-2xl bg-fill px-[18px] transition-colors hover:bg-fill-2">
          <span class="flex-1 font-medium">Email</span>
          <span class="truncate text-sm text-fg-3">{SITE.email}</span>
        </a>
      </div>
    </section>
  </div>
</Base>
