---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import LicensePage from '../../../views/LicensePage.astro';

export const getStaticPaths = (async () => (await getCollection('licenses')).filter((l) => Boolean(l.body?.trim()) || l.data.prices.length > 0).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<LicensePage lang="en" license={entry} />
