---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Permission from '../components/common/Permission.astro';
import { type Lang, localePath, useT } from '../i18n';
import { hasLicensePage, isLicenseShown } from '../lib/licenses';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const licenses = (await getCollection('licenses', isLicenseShown)).sort((a, b) => Number(b.data.commercial) - Number(a.data.commercial) || a.data.name.localeCompare(b.data.name));
---

<Base lang={lang} title={t('Лицензиялар')} description={t('Сайттағы қаріптер үшін қолданылатын лицензиялар туралы толық ақпарат')}>
  <PageHeader eyebrow={t('Заңды ақпарат')} title={t('Лицензиялар')} description={t('Сайттағы қаріптер үшін қолданылатын лицензиялар туралы толық ақпарат')} />
  <div class="space-y-4">
    {
      licenses.map((l) => {
        const hasPage = hasLicensePage(l);
        return (
          <section class="card p-6" id={l.id}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-xl font-bold">{l.data.name}</h2>
              {hasPage && (
                <a class="link text-sm" href={localePath(lang, `/licenses/${l.id}`)}>
                  {t('Толық мәтін')} →
                </a>
              )}
            </div>
            <p class="mt-3 whitespace-pre-line text-muted">{l.data.description}</p>
            <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              <Permission label={t('Коммерциялық қолдану')} ok={l.data.commercial} yes={t('Рұқсат етілген')} no={t('Тыйым салынған')} />
              <Permission label={t('Өзгерту')} ok={l.data.modification} yes={t('Рұқсат етілген')} no={t('Тыйым салынған')} />
              <Permission label={t('Тарату')} ok={l.data.distribution} yes={t('Рұқсат етілген')} no={t('Тыйым салынған')} />
              <Permission label={t('Авторды көрсету')} ok={l.data.attribution} yes={t('Міндетті')} no={t('Міндетті емес')} neutral />
            </div>
            {l.data.url && (
              <p class="mt-5 text-sm">
                <a class="link break-all" href={l.data.url} target="_blank" rel="noopener noreferrer">
                  {l.data.url}
                </a>
              </p>
            )}
          </section>
        );
      })
    }
  </div>
</Base>
