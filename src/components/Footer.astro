---
import { type Lang, localePath, useT } from '../i18n';
import { SITE, TOOLS } from '../lib/site';
import Icon from './ui/Icon';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const columns = [
  {
    title: 'Қаріптер',
    links: [
      { href: '/fonts', label: 'Барлық қаріп' },
      { href: '/fonts?our=1', label: 'Біздің қаріп' },
      { href: '/top', label: 'Топ қаріптер' },
      { href: '/fonts?free=1', label: 'Тегін қаріптер' },
    ],
  },
  {
    title: 'Ақпарат',
    links: [
      { href: '/about', label: 'Біз туралы' },
      { href: '/journal', label: 'Journal' },
      { href: '/glossary', label: 'Сөздік' },
      { href: '/typography', label: 'Типография' },
      { href: '/faq', label: 'Жиі қойылатын сұрақтар' },
      { href: '/support', label: 'Жобаны қолдау' },
    ],
  },
  { title: 'Құралдар', links: [{ href: '/services', label: 'Қызметтер' }, ...TOOLS.map((x) => ({ href: x.href, label: x.label }))] },
  {
    title: 'Заңды',
    links: [
      { href: '/licenses', label: 'Лицензия түрлері' },
      { href: '/privacy', label: 'Құпия саясаты' },
      { href: '/terms', label: 'Қолдану шарты' },
    ],
  },
];
---

<footer class="mt-20 border-t border-line">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div>
      <a href={localePath(lang, '/')} class="text-lg font-extrabold tracking-tight">Qarip</a>
      <p class="mt-3 max-w-xs text-sm text-muted">{t('Қазақ тілін қолдайтын тегін қаріптер жинағы.')}</p>
      <div class="mt-5 flex gap-1">
        <a href={SITE.telegram} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Telegram"><Icon name="send" /></a>
        <a href={SITE.instagram} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href={`mailto:${SITE.email}`} class="icon-btn" aria-label="Email"><Icon name="mail" /></a>
      </div>
    </div>
    {
      columns.map((col) => (
        <div>
          <p class="mb-4 text-sm font-semibold">{t(col.title)}</p>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a href={localePath(lang, link.href)} class="text-sm text-muted transition-colors hover:text-fg">
                  {t(link.label)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container-page border-t border-line py-6 text-sm text-muted">
    © {new Date().getFullYear()} Qarip. {t('Барлық құқы қорғалған')}
  </div>
</footer>
