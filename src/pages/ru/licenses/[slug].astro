---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { hasLicensePage } from '../../../lib/licenses';
import LicensePage from '../../../views/LicensePage.astro';

export const getStaticPaths = (async () => (await getCollection('licenses', hasLicensePage)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<LicensePage lang="ru" license={entry} />
