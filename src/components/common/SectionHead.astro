---
/** Section title with an optional "see all →" link on the right. */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  /** Extra text next to the title (a count). */
  note?: string | number;
}
const { title, href, linkLabel, note } = Astro.props;
---

<div class="mb-4 flex items-baseline justify-between gap-4">
  <h2 class="title-md">
    {title}
    {note !== undefined && <span class="font-medium text-fg-3">{note}</span>}
  </h2>
  {href && <a href={href} class="link-more">{linkLabel} →</a>}
</div>
