---
import type { CollectionEntry } from 'astro:content';
import { type Lang, formatDate, localePath } from '../../i18n';

interface Props {
  post: CollectionEntry<'journal'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
---

<article class="card group relative overflow-hidden transition-colors hover:border-muted" data-search={`${post.data.title} ${post.data.excerpt ?? ''} ${post.data.author ?? ''}`.toLowerCase()}>
  <div class="aspect-[16/9] overflow-hidden bg-surface-2">
    {
      post.data.cover ? (
        <img src={post.data.cover} alt="" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      ) : (
        <div class="flex size-full items-center justify-center text-5xl font-bold text-muted/40">Aa</div>
      )
    }
  </div>
  <div class="p-5">
    <h3 class="font-bold">
      <a href={localePath(lang, `/journal/${post.id}`)} class="after:absolute after:inset-0">{post.data.title}</a>
    </h3>
    {post.data.excerpt && <p class="mt-1 line-clamp-2 text-sm text-muted">{post.data.excerpt}</p>}
    <p class="mt-3 text-xs text-muted">
      {post.data.author && <span>{post.data.author} · </span>}
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(lang, post.data.pubDate)}</time>
    </p>
  </div>
</article>
