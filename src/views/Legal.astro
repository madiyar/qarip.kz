---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { type Lang, localePath, useT } from '../i18n';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
  page: 'terms' | 'privacy';
}
const { lang, page } = Astro.props;
const t = useT(lang);
const content = {
  terms: {
    title: 'Қолдану шарты',
    sections: [
      ['Сайт туралы', 'qarip.kz сайты қазақ тілін қолдайтын қаріптерді жинап, ұсыну үшін арналған.'],
      ['Қаріптер туралы', 'Әр қаріптің өз лицензиясы бар. Қаріпті қолданбас бұрын оның лицензиясын мұқият оқып шығыңыз. Лицензия әр қаріп бетіндегі «Лицензия» бөлімінде көрсетілген.'],
      ['Жауапкершілік туралы', 'Сайт қаріпті жүктеп алғаннан кейінгі сіздің әрекеттеріңізге жауапты емес. Қаріпті лицензиясына сай қолдану жауапкершілігі сізде.'],
      ['Авторлық құқық', 'Қаріптердің авторлық құқығы олардың авторларына тиесілі. Құқығыңыз бұзылды деп есептесеңіз, бізге жазыңыз — материалды тексеріп, алып тастаймыз.'],
      ['Өзгерістер', 'Шарттар ескертусіз өзгеруі мүмкін. Сайтты қолдануды жалғастыру жаңа шарттармен келісуді білдіреді.'],
    ],
  },
  privacy: {
    title: 'Құпия саясаты',
    sections: [
      ['Қандай дерек жинаймыз', 'Сайт тіркелуді қажет етпейді және жеке деректеріңізді жинамайды.'],
      ['Браузердегі деректер', 'Таңдаулылар, жүктеу тарихы, каталогтар, тақырып пен тіл параметрлері тек сіздің браузеріңізде (localStorage) сақталады және серверге жіберілмейді. Оларды браузер деректерін тазалау арқылы өшіре аласыз.'],
      ['Құралдар', 'Тестер, конвертер, Font Freezer сияқты құралдарға жүктеген файлдар сіздің құрылғыңызда өңделеді және ешқайда жіберілмейді.'],
      ['Үшінші тарап', 'Сайт Google Fonts қызметінен интерфейс қаріптерін жүктейді. Хостинг провайдері (Netlify) стандартты сервер журналдарын жүргізуі мүмкін.'],
      ['Байланыс', 'Сұрақтар бойынша бізге жазыңыз: {email}'],
    ],
  },
}[page];
---

<Base lang={lang} title={t(content.title)}>
  <div class="mx-auto max-w-3xl">
    <PageHeader eyebrow={t('Заңды ақпарат')} title={t(content.title)} />
    <div class="space-y-8">
      {
        content.sections.map(([title, text]) => (
          <section>
            <h2 class="text-xl font-semibold">{t(title)}</h2>
            <p class="mt-2 text-muted">{t(text, { email: SITE.email })}</p>
          </section>
        ))
      }
    </div>
    <p class="mt-12 text-sm text-muted">
      <a class="link" href={localePath(lang, page === 'terms' ? '/privacy' : '/terms')}>{t(page === 'terms' ? 'Құпия саясаты' : 'Қолдану шарты')}</a> ·
      <a class="link" href={localePath(lang, '/licenses')}>{t('Лицензия түрлері')}</a>
    </p>
  </div>
</Base>
