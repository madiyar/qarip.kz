---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import DownloadCount from '../components/common/DownloadCount.astro';
import FontActions from '../components/fonts/FontActions';
import FontDetail from '../components/fonts/FontDetail';
import { FontCard } from '../components/fonts/FontRow';
import QualityIndicator from '../components/fonts/QualityIndicator';
import OwnBadge from '../components/ui/OwnBadge';
import Icon from '../components/ui/Icon';
import { CATEGORY, breadcrumbLd, categoryLabel, fontSummary, fontTitle } from '../lib/seo';
import { type Lang, formatDate, localePath, useT } from '../i18n';
import { hasLicensePage } from '../lib/licenses';
import { type FontEntry, byDesigner, familyName, formatBytes, getFonts, primaryFaces, publicCssBlocks, similarFonts, styleFaces, toSummaries } from '../lib/fonts';

interface Props {
  lang: Lang;
  font: FontEntry;
}
const { lang, font } = Astro.props;
const t = useT(lang);
const d = font.data;

const [category, license, all] = await Promise.all([getEntry(d.category), getEntry(d.license), getFonts()]);
const designers = (await Promise.all(d.designers.map((x) => getEntry(x)))).filter((x) => x !== undefined);
const designerNames = designers.map((x) => x.data.name);
const tags = await Promise.all(d.tags.map((x) => getEntry(x)));
const purposes = await Promise.all(d.purposes.map((x) => getEntry(x)));
const similar = await toSummaries(await similarFonts(font, all, 3), lang);
const licenseShown = Boolean(license?.data.visible);
const description = { kk: d.description, ru: d.descriptionRu ?? d.description, en: d.descriptionEn ?? d.description }[lang];

const SCRIPT_LABELS: Record<string, string> = { kazakh: 'Қазақ кирилл', 'kazakh-latin': 'Қазақ латын', cyrillic: 'Кирилл', latin: 'Латын' };
const glyphs = Math.max(0, ...d.styles.map((s) => s.glyphs ?? 0));
const formats = [...new Set(d.styles.map((s) => s.format.toUpperCase()))].join(', ');

const styles = d.styles.map((s) => ({ ...s, family: familyName(font.id, s.slug) }));
const cssUrl = new URL(`/fonts/${font.id}.css`, Astro.site).toString();
const info = [
  { label: 'Қаріп атауы', value: d.name },
  { label: 'Категория', value: categoryLabel(lang, d.category.id, category?.data.name ?? '') },
  { label: designers.length > 1 ? 'Дизайнерлер' : 'Дизайнер', value: designerNames.join(', ') },
  { label: 'Стиль саны', value: String(d.styles.length) },
  { label: 'Форматтар', value: formats },
  { label: 'Лицензия', value: license?.data.name ?? '' },
  { label: 'Әліпбилер', value: d.scripts.map((s) => t(SCRIPT_LABELS[s] ?? s)).join(', ') },
  ...(purposes.length ? [{ label: 'Мақсаты', value: purposes.map((p) => t(p!.data.name)).join(', ') }] : []),
  { label: 'Қосылған күні', value: formatDate(lang, d.addedDate) },
  ...(d.releaseDate ? [{ label: 'Шыққан күні', value: d.releaseDate }] : []),
  ...(d.updatedDate ? [{ label: 'Жаңартылған', value: d.updatedDate }] : []),
];
const stats = [
  { label: 'Стиль саны', value: String(d.styles.length) },
  { label: 'Глиф саны', value: glyphs ? String(glyphs) : '—' },
  { label: 'Әліпбилер', value: String(d.scripts.length) },
];
// Catalog links on the Info tab.
const tagLinks = [
  ...purposes.flatMap((p) => (p ? [{ label: t(p.data.name), href: localePath(lang, `/fonts?purpose=${p.id}`) }] : [])),
  ...tags.flatMap((tag) => (tag ? [{ label: t(tag.data.name), href: localePath(lang, `/fonts?tag=${tag.id}`) }] : [])),
];
const designerLinks = designers.map((x) => ({ name: x.data.name, href: localePath(lang, `/designers/${x.id}`), fonts: byDesigner(all, x.id).length }));
const catLabel = categoryLabel(lang, d.category.id, category?.data.name ?? d.category.id);
const commercial = Boolean(license?.data.commercial);
const primaryFamily = styles[d.primary]?.family ?? styles[0].family;
// The Files block lists what the visitor gets: the contents of the ZIP.
const files = d.zipFiles.map((f) => ({ name: f.name, format: f.name.includes('.') ? f.name.split('.').pop()!.toLowerCase() : '', size: formatBytes(f.size) }));

const site = Astro.site!;
const pageUrl = new URL(localePath(lang, `/fonts/${font.id}`), site).toString();
const ogImage = `/og/${font.id}.png`;
// Factual summary used for the meta description and shown on the page.
const summary = fontSummary(lang, {
  name: d.name,
  designers: designerNames,
  category: d.category.id,
  styles: d.styles.length,
  glyphs,
  scripts: d.scripts,
  license: license?.data.name ?? '',
  commercial: Boolean(license?.data.commercial),
  formats,
});
const catName = CATEGORY[d.category.id]?.name[lang] ?? category?.data.name ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${pageUrl}#font`,
  name: d.name,
  description: summary,
  url: pageUrl,
  image: new URL(ogImage, site).toString(),
  applicationCategory: 'DesignApplication',
  applicationSubCategory: 'Font',
  operatingSystem: 'Windows, macOS, Linux',
  inLanguage: ['kk', 'ru', 'en'],
  datePublished: d.addedDate.toISOString().slice(0, 10),
  author: designers.map((x) => ({ '@type': 'Person', name: x.data.name, url: new URL(localePath(lang, `/designers/${x.id}`), site).toString() })),
  publisher: { '@id': new URL('/#organization', site).toString() },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'KZT', availability: 'https://schema.org/InStock' },
  license: license?.data.url,
  downloadUrl: new URL(d.zip, site).toString(),
  fileFormat: d.styles.map((s) => `font/${s.format}`).filter((v, i, a) => a.indexOf(v) === i),
  keywords: ['қазақша шрифт', 'қазақша қаріп', 'казахский шрифт', 'kazakh font', catName, d.name].join(', '),
};
const crumbs = breadcrumbLd(site, [
  { name: 'Qarip', path: localePath(lang, '/') },
  { name: t('Қаріптер'), path: localePath(lang, '/fonts') },
  { name: catName, path: localePath(lang, `/fonts/category/${d.category.id}`) },
  { name: d.name, path: localePath(lang, `/fonts/${font.id}`) },
]);
const downloadHeading = { kk: `${d.name} шрифтін жүктеу`, ru: `Скачать шрифт ${d.name}`, en: `Download the ${d.name} font` }[lang];
// Short names get a bigger specimen title.
const h1Size = d.name.length > 9 ? 'text-[48px] sm:text-[84px]' : 'text-[60px] sm:text-[112px]';
---

<Base
  lang={lang}
  fullTitle={`${fontTitle(lang, d.name)} | Qarip`}
  description={summary}
  image={ogImage}
  fontCss={`${styleFaces(font)}\n${primaryFaces(similar)}`}
  wide
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />

  <div class="wrap-md pt-7">
    <Breadcrumbs
      label={t('Жол')}
      items={[
        { label: t('Қаріптер'), href: localePath(lang, '/fonts') },
        { label: catLabel, href: localePath(lang, `/fonts/category/${d.category.id}`) },
      ]}
    />

    <header class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6 pt-7 pb-8">
      <div class="min-w-0 flex-[1_1_420px]">
        <h1 class:list={['leading-[0.95] font-normal tracking-[-0.01em] [overflow-wrap:anywhere]', h1Size]} style={`font-family:'${primaryFamily}', system-ui`}>
          {d.name}
        </h1>
        {
          description && (
            <div class="mt-3.5 max-w-[680px]">
              <p id="font-desc" class="line-clamp-3 text-base leading-relaxed whitespace-pre-line text-fg-2">
                {description}
              </p>
              <button type="button" class="link mt-1 text-sm" data-desc-more hidden>
                {t('Толығырақ')}
              </button>
            </div>
          )
        }
        <div class="mt-3 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-sm text-fg-3">
          <span>
            {
              designers.map((x, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={localePath(lang, `/designers/${x.id}`)} class="font-medium text-fg transition-colors hover:text-accent-ink">
                    {x.data.name}
                  </a>
                </>
              ))
            }
          </span>
          <span>{t('{n} стиль', { n: d.styles.length })}</span>
          <DownloadCount slug={font.id} count={d.downloads} label={t('{n} жүктеу', { n: '{n}' })} />
          {d.quality && <QualityIndicator quality={d.quality} label={t('Сапа')} wide />}
          {d.our && <OwnBadge />}
        </div>
      </div>
      <FontActions
        client:load
        slug={font.id}
        name={d.name}
        zip={d.zip}
        zipName={d.zipName}
        zipSize={formatBytes(d.zipSize)}
        commercial={commercial}
        purchaseUrl={d.purchaseUrl}
        lang={lang}
      />
    </header>

    <div id="dl-thanks"></div>

    <FontDetail
      client:load
      lang={lang}
      name={d.name}
      slug={font.id}
      previewText={d.previewText}
      styles={styles}
      primary={d.primary}
      license={{
        slug: license!.id,
        name: license!.data.name,
        description: license!.data.description,
        url: license!.data.url,
        commercial: license!.data.commercial,
        modification: license!.data.modification,
        distribution: license!.data.distribution,
        attribution: license!.data.attribution,
        shown: licenseShown,
        hasPage: hasLicensePage(license!),
      }}
      purchaseUrl={d.purchaseUrl}
      cssBlocks={publicCssBlocks(font, Astro.site!)}
      cssUrl={cssUrl}
      info={info}
      stats={stats}
      downloads={d.downloads}
      files={files}
      zipName={d.zipName ?? `${font.id}.zip`}
      tags={tagLinks}
      designers={designerLinks}
    />

    <!-- Plain-text summary: answers "download <font>" queries and links the category and license. -->
    <section class="note mt-20 max-w-[720px] px-6 py-5">
      <h2 class="title-sm">{downloadHeading}</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-fg-3">{summary}</p>
      <p class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <a href={d.zip} download={d.zipName ?? true} class="link inline-flex items-center gap-1.5 font-medium" data-download={font.id}>
          <Icon name="download" size={15} />
          {t('Жүктеу')} · ZIP · {formatBytes(d.zipSize)}
        </a>
        <a href={localePath(lang, `/fonts/category/${d.category.id}`)} class="link-quiet">{catName}</a>
        {licenseShown ? <a href={localePath(lang, '/licenses')} class="link-quiet">{license?.data.name}</a> : <span class="text-fg-3">{license?.data.name}</span>}
      </p>
    </section>

    {
      similar.length > 0 && (
        <section class="section pb-4">
          <h2 class="title-md mb-5">{t('Ұқсас қаріптер')}</h2>
          <div class="grid gap-4 sm:grid-cols-[repeat(auto-fill,minmax(300px,1fr))]">
            {similar.map((f) => (
              <FontCard font={f} lang={lang} preview={{ text: '', size: 30, textCase: 'none', view: 'grid' }} text="Қазақ қаріп қоры" lines={2} meta="category" favorite={false} />
            ))}
          </div>
        </section>
      )
    }
    <!-- Room for the fixed action bar on phones. -->
    <div class="h-[72px] sm:hidden"></div>
  </div>
</Base>

<script>
  // Long descriptions are cut to three lines with a "More" button.
  const desc = document.getElementById('font-desc');
  const more = document.querySelector<HTMLButtonElement>('[data-desc-more]');
  if (desc && more && desc.scrollHeight > desc.clientHeight + 2) {
    more.hidden = false;
    more.addEventListener('click', () => {
      desc.classList.remove('line-clamp-3');
      more.remove();
    });
  }
</script>
