---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/common/SectionHead.astro';
import ArticleCard from '../components/common/ArticleCard.astro';
import HomeFonts from '../components/fonts/HomeFonts';
import { type Lang, localePath, useT } from '../i18n';
import { getPosts } from '../lib/journal';
import { byPopularity } from '../lib/downloads';
import { familyName, getCategories, getFonts, primaryFaces, toSummaries } from '../lib/fonts';
import { HOME, websiteLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const fonts = await toSummaries(await getFonts(), lang);
const categories = await getCategories(lang);
const popular = [...fonts].sort(byPopularity);
// Six per tab: two rows of three cards.
const PER_TAB = 6;
const ours = fonts.filter((f) => f.our);
// Order: new, popular, Qarip's own.
const tabs = [
  { id: 'new', label: 'Жаңа қосылды', href: '/fonts', more: 'Барлық {n} қаріпті көру', fonts: fonts.slice(0, PER_TAB) },
  { id: 'popular', label: 'Танымал', href: '/top', more: 'Толық рейтинг', fonts: popular.slice(0, PER_TAB) },
  ...(ours.length ? [{ id: 'our', label: 'Qarip қаріптері', href: '/fonts?our=1', more: 'Барлық Qarip қаріптері', fonts: ours.slice(0, PER_TAB) }] : []),
];
// Each category is shown in its most popular font.
const categoryCards = categories.map((c) => {
  const inCat = popular.filter((f) => f.category.id === c.id);
  return { ...c, count: inCat.length, sample: inCat[0] };
});
const shown = [...new Map([...tabs.flatMap((x) => x.fonts), ...categoryCards.flatMap((c) => (c.sample ? [c.sample] : []))].map((f) => [f.slug, f])).values()];
const posts = (await getPosts()).slice(0, 3);
---

<Base lang={lang} fullTitle={HOME.title[lang]} description={HOME.description[lang]} fontCss={primaryFaces(shown)} wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(websiteLd(Astro.site!, lang))} />

  <section class="wrap pt-7 pb-8 sm:pt-[72px]">
    <h1 class="title-xl">{t('Қазақ қаріп қоры')}</h1>
    <p class="mt-3.5 max-w-[620px] text-base leading-normal text-fg-3 sm:text-[17px]">
      {t('Қазақ әріптерін толық қолдайтын тегін қаріптер, дизайнерге құралдар және типография туралы мақалалар — бәрі бір жерде.')}
    </p>
  </section>

  <section class="wrap pt-2" aria-label={t('Қаріптер')}>
    <HomeFonts client:visible lang={lang} tabs={tabs} total={fonts.length} />
  </section>

  {
    posts.length > 0 && (
      <section class="wrap section">
        <SectionHead title="Journal" href={localePath(lang, '/journal')} linkLabel={t('Барлық мақала')} />
        <div class="grid grid-cols-[minmax(0,1fr)] gap-x-5 gap-y-8 sm:grid-cols-[repeat(auto-fill,minmax(300px,1fr))]">
          {posts.map((post) => (
            <ArticleCard post={post} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <SectionHead title={t('Стиль таңдап ал')} />
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fit,minmax(150px,1fr))]">
      {
        categoryCards.map((c) => (
          <a href={localePath(lang, `/fonts/category/${c.id}`)} class="card-link hover-name flex flex-col gap-3.5 rounded-[18px] px-[18px] pt-[18px] pb-4">
            <span aria-hidden="true" class="text-[40px] leading-none" style={c.sample ? `font-family:'${familyName(c.sample.slug)}', system-ui` : undefined}>
              Аа
            </span>
            <span>
              <b class="font-name">{c.label}</b>
              <span class="meta">
                <span class="cat-ink font-medium" style={`--cat:${c.color}`}>{c.term}</span> · {c.count}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="max-w-[680px] text-sm leading-[1.65] text-fg-3">
      <h2 class="mb-2 text-[15px] font-semibold text-fg-2">{HOME.aboutTitle[lang]}</h2>
      {HOME.about[lang].map((p) => <p class="mb-2.5">{p}</p>)}
      <p>
        {t('Категориялар')}:{' '}
        {
          categories.map((c, i) => (
            <>
              {i > 0 && ', '}
              <a class="link-quiet" href={localePath(lang, `/fonts/category/${c.id}`)}>
                {c.title}
              </a>
            </>
          ))
        }
        .
      </p>
    </div>
  </section>
</Base>
