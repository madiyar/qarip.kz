---
import Base from '../layouts/Base.astro';
import ToolHeader from '../components/tools/ToolHeader.astro';
import OtherTools from '../components/tools/OtherTools.astro';
import Tester from '../components/tools/Tester';
import Converter from '../components/tools/Converter';
import Pairing from '../components/tools/Pairing';
import Proofing from '../components/tools/Proofing';
import Freezer from '../components/tools/Freezer';
import Kerning from '../components/tools/Kerning';
import { type Lang, useT } from '../i18n';
import { TOOLS } from '../lib/site';
import { getFonts, primaryFaces, toSummaries } from '../lib/fonts';

export type ToolId = 'tester' | 'converter' | 'pairing' | 'proofing' | 'freezer' | 'kerning';

interface Props {
  lang: Lang;
  tool: ToolId;
}
const { lang, tool } = Astro.props;
const t = useT(lang);
const meta = TOOLS.find((x) => x.href === `/tools/${tool}`)!;
const entries = await getFonts();
const needsCatalog = tool === 'pairing' || tool === 'proofing';
const fonts = needsCatalog ? await toSummaries(entries, lang) : [];
const catalog = tool === 'freezer' ? entries.map((f) => ({ name: f.data.name, styles: f.data.styles.map((s) => ({ name: s.name, file: s.file })) })) : [];
const intro: Record<ToolId, string> = {
  tester: 'Қаріп файлын тастаңыз — қазақ әріптерін, глифтерді, OpenType мүмкіндіктерін және вариатив осьтерді тексереміз.',
  converter: 'TTF, OTF, WOFF және WOFF2 арасында түрлендіру. Сайтқа әдетте WOFF2 жеткілікті.',
  pairing: 'Сайттағы қаріптерден автоматты үйлесім жасаңыз',
  proofing: 'Қаріпті түрлі өлшемде және мәтінде тексеріп, басып шығарыңыз',
  freezer: 'Стилистикалық жиындар мен баламалы әріптерді қаріптің әдепкі түріне айналдырыңыз — OpenType қолдамайтын бағдарламаларда да жұмыс істейді.',
  kerning: 'Қаріп кернингін тексеру және баптау үшін таңба комбинацияларын жасаңыз.',
};
---

<Base lang={lang} title={t(meta.title)} description={t(intro[tool])} fontCss={fonts.length ? primaryFaces(fonts) : undefined} wide>
  <div class="wrap pt-7">
  <ToolHeader lang={lang} title={t(meta.title)} description={t(intro[tool])} local={tool !== 'pairing'} />
  {tool === 'tester' && <Tester client:load lang={lang} />}
  {tool === 'converter' && <Converter client:load lang={lang} />}
  {tool === 'pairing' && <Pairing client:load lang={lang} fonts={fonts} />}
  {tool === 'proofing' && <Proofing client:load lang={lang} fonts={fonts} />}
  {tool === 'freezer' && <Freezer client:load lang={lang} catalog={catalog} />}
  {tool === 'kerning' && <Kerning client:load lang={lang} />}

  <OtherTools lang={lang} current={meta.href} />
  </div>
</Base>
