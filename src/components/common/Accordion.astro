---
/** Questions and answers (FAQ): a boxed list of <details>. Answers are trusted HTML. */
interface Props {
  items: { id?: string; title: string; html: string; meta?: string; search?: string; group?: string }[];
}
const { items } = Astro.props;
---

<div class="panel overflow-hidden !rounded-[20px]">
  {
    items.map((item) => (
      <details class="group border-b border-line last:border-0" id={item.id} data-search={item.search} data-group={item.group}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-[22px] py-[18px] text-base font-semibold transition-colors hover:bg-fill [&::-webkit-details-marker]:hidden">
          <span>
            {item.title}
            {item.meta && <span class="ml-2 text-sm font-normal text-fg-3">{item.meta}</span>}
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-3 transition-transform group-open:rotate-45" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
        </summary>
        <div class="px-[22px] pb-5 leading-relaxed text-fg-2 [&_a]:text-accent-ink [&_a]:underline [&_a]:underline-offset-[3px] [&_code]:rounded [&_code]:bg-fill [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.88em] [&_li]:ml-5 [&_li]:list-disc [&_p+p]:mt-2.5 [&_ul]:mt-2" set:html={item.html} />
      </details>
    ))
  }
</div>
