---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { type Lang, localePath, useT } from '../i18n';
import { byPopularity } from '../lib/downloads';
import { familyName, getCategories, getFonts, primaryFaces, toSummaries } from '../lib/fonts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const categories = await getCategories(lang);
const fonts = (await toSummaries(await getFonts(), lang)).sort(byPopularity);
// Each category is shown in its most popular font from the catalog.
const cards = categories.map((c) => ({ ...c, sample: fonts.find((f) => f.category.id === c.id) }));
const samples = cards.flatMap((c) => (c.sample ? [c.sample] : []));
const tips = [
  ['Мақсатқа қараңыз', 'Сайт пен интерфейске кесілген (sans) қаріптер, баспа кітапқа кертілген (serif) қаріптер жарасады.'],
  ['Екі қаріп жеткілікті', 'Бір жобада тақырыпқа бір, мәтінге бір қаріп қолдансаңыз жетеді. Үйлесімін «Қаріп үйлесімі» құралынан табыңыз.'],
  ['Қазақ әріптерін тексеріңіз', 'Ә, Ғ, Қ, Ң, Ө, Ұ, Ү, Һ, І әріптері бар екеніне және дұрыс салынғанына көз жеткізіңіз.'],
  ['Лицензияны оқыңыз', 'Тегін қаріптің бәрі коммерцияға тегін емес. Қолданбас бұрын лицензиясын тексеріңіз.'],
];
---

<Base lang={lang} title={t('Типография')} description={t('Қазақ тіліндегі типография туралы ақпарат')} fontCss={primaryFaces(samples)}>
  <div class="mx-auto max-w-[960px]">
    <PageHeader size="lg" title={t('Типография')} description={t('Қазақ тіліндегі типография туралы ақпарат')} />
    <section class="note p-6 sm:p-8">
      <h2 class="title-md">{t('Типография дегеніміз не?')}</h2>
      <p class="mt-2.5 max-w-[680px] leading-relaxed text-fg-2">
        {t('Типография — мәтінді көрнекі түрде ұйымдастыру өнері мен техникасы. Ол қаріптер, өлшемдер, аралықтар және басқа элементтерді пайдаланып, мәтінді оқылымды және әсем етеді.')}
      </p>
    </section>

    <section class="mt-14">
      <h2 class="title-md mb-4">{t('Қаріп түрлері')}</h2>
      <div class="grid gap-3 sm:grid-cols-[repeat(auto-fill,minmax(260px,1fr))]">
        {
          cards.map((c) => (
            <a href={localePath(lang, `/fonts/category/${c.id}`)} class="card-link hover-name flex flex-col gap-4 p-5">
              <span aria-hidden="true" class="text-5xl leading-none" style={c.sample ? `font-family:'${familyName(c.sample.slug)}', system-ui` : undefined}>
                Аа Әә
              </span>
              <span>
                <b class="font-name">{c.label}</b>
                <span class="mt-0.5 block text-sm text-fg-3">{t(c.description)}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <h2 class="title-md mb-4">{t('Қаріпті қалай таңдау керек?')}</h2>
      <div class="grid gap-x-8 sm:grid-cols-2">
        {
          tips.map(([title, text], i) => (
            <div class="border-b border-line py-4">
              <span class="text-[13px] font-semibold text-accent-ink">0{i + 1}</span>
              <b class="mt-1 block font-semibold">{t(title)}</b>
              <p class="mt-1 text-[15px] text-fg-2">{t(text)}</p>
            </div>
          ))
        }
      </div>
    </section>

    <p class="mt-10">
      <a class="btn-secondary" href={localePath(lang, '/glossary')}>{t('Типографиялық сөздік')} →</a>
    </p>
  </div>
</Base>
