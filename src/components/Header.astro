---
/**
 * Site header (glass bar). Desktop: navigation, tools menu, search, language, theme,
 * favourites and the Support button. Phones and tablets: logo, Support and search on top;
 * the rest lives in the bottom tab bar (MobileNav.astro).
 */
import { type Lang, barePath, localePath, useT } from '../i18n';
import LangSwitch from './LangSwitch.astro';
import Logo from './layout/Logo.astro';
import ToolGlyph from './layout/ToolGlyph.astro';
import Icon from './ui/Icon';
import { NAV, TOOLS } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = barePath(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const fontsActive = ['/fonts', '/top', '/designers'].some(isActive);
const toolsActive = isActive('/tools') || TOOLS.some((tool) => isActive(tool.href));
const navClass = (on: boolean) => ['py-1.5 transition-colors hover:text-fg', on ? 'font-semibold text-fg' : 'text-fg-2'];
---

<header class="site-header sticky top-0 z-40 border-b border-[var(--glass-line)] bg-[var(--glass)] backdrop-blur-xl backdrop-saturate-[1.8]">
  <div class="wrap flex h-14 items-center gap-8 text-sm">
    <Logo href={localePath(lang, '/')} label={t('Qarip — басты бет')} />

    <nav class="hidden flex-1 items-center gap-5 lg:flex" aria-label={t('Негізгі мәзір')}>
      <a href={localePath(lang, '/fonts')} class:list={navClass(fontsActive)} aria-current={fontsActive ? 'page' : undefined}>{t('Қаріптер')}</a>
      <div class="relative" data-dropdown>
        <button type="button" class:list={['flex items-center gap-1', ...navClass(toolsActive)]} aria-expanded="false" aria-haspopup="true" aria-controls="tools-menu" data-dropdown-trigger>
          {t('Құралдар')}
          <Icon name="chevronDown" size={12} strokeWidth={2.4} className="transition-transform [[aria-expanded=true]>&]:rotate-180" />
        </button>
        <div id="tools-menu" class="pop absolute top-[calc(100%+12px)] -left-4 z-50 hidden w-[560px] max-w-[calc(100vw-2rem)] p-2" data-dropdown-menu>
          <div class="grid grid-cols-2 gap-0.5">
            {
              TOOLS.map((tool) => (
                <a href={localePath(lang, tool.href)} class="flex items-center gap-3 rounded-xl p-2.5 transition-colors hover:bg-fill">
                  <ToolGlyph glyph={tool.glyph} font={tool.glyphFont} />
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold">{t(tool.title)}</span>
                    <span class="block truncate text-xs text-fg-3">{t(tool.description)}</span>
                  </span>
                </a>
              ))
            }
          </div>
          <a href={localePath(lang, '/tools')} class="mx-0.5 mt-1.5 block border-t border-line px-2 pt-3 pb-1.5 text-[13px] font-medium text-accent-ink hover:underline">
            {t('Барлық құралдар')} →
          </a>
        </div>
      </div>
      {
        NAV.map((item) => (
          <a href={localePath(lang, item.href)} class:list={navClass(isActive(item.href))} aria-current={isActive(item.href) ? 'page' : undefined}>
            {t(item.label)}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto hidden items-center gap-1 lg:flex">
      <button type="button" class="flex h-9 items-center gap-2 rounded-[10px] bg-fill pr-2.5 pl-3 text-fg-3 transition-colors hover:text-fg" data-search-open>
        <Icon name="search" size={15} />
        <span class="hidden min-w-[110px] text-left xl:inline">{t('Қаріп іздеу')}</span>
        <span class="sr-only xl:hidden">{t('Қаріп іздеу')}</span>
        <kbd class="kbd hidden xl:inline">⌘K</kbd>
      </button>
      <LangSwitch lang={lang} class="mx-1" />
      <button type="button" class="icon-btn size-9" data-theme-toggle aria-label={t('Тақырыпты ауыстыру')} title={t('Тақырыпты ауыстыру')}>
        <Icon name="sun" size={17} className="hidden dark:block" />
        <Icon name="moon" size={17} className="block dark:hidden" />
      </button>
      <a href={localePath(lang, '/profile')} class="icon-btn relative size-9" aria-label={t('Менің қаріптерім')} title={t('Менің қаріптерім')}>
        <Icon name="heart" size={18} />
        <span class="counter absolute top-0.5 right-0 hidden" data-fav-count></span>
      </a>
      <a href={localePath(lang, '/support')} class="btn-primary btn-sm ml-2 pr-3.5 pl-3">
        <Icon name="tenge" size={16} />
        {t('Қолдау')}
      </a>
    </div>

    <div class="ml-auto flex items-center lg:hidden">
      <a href={localePath(lang, '/support')} class="btn-primary h-[34px] gap-1.5 pr-3 pl-2.5 text-[13px]">
        <Icon name="tenge" size={15} />
        {t('Қолдау')}
      </a>
      <button type="button" class="icon-btn -mr-2 size-11 text-fg" aria-label={t('Қаріп іздеу')} data-search-open>
        <Icon name="search" size={21} />
      </button>
    </div>
  </div>
</header>

<script>
  import { store } from '../lib/store';

  const root = document.documentElement;
  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    }),
  );

  // Favourites counter (header heart and tab bar).
  const counters = document.querySelectorAll<HTMLElement>('[data-fav-count]');
  const showCount = () => {
    const n = store.get().favorites.length;
    counters.forEach((el) => {
      el.textContent = String(n);
      el.classList.toggle('hidden', n === 0);
    });
  };
  showCount();
  window.addEventListener('qarip:store', showCount);
  window.addEventListener('storage', showCount);

  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
    const trigger = dd.querySelector<HTMLElement>('[data-dropdown-trigger]')!;
    const panel = dd.querySelector<HTMLElement>('[data-dropdown-menu]')!;
    const set = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', () => set(panel.classList.contains('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        set(false);
        trigger.focus();
      }
    });
    document.addEventListener('click', (e) => !dd.contains(e.target as Node) && set(false));
  });
</script>
