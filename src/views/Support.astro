---
import Base from '../layouts/Base.astro';
import ShareButton from '../components/common/ShareButton';
import CopyButton from '../components/ui/CopyButton';
import { type Lang, localePath, useT } from '../i18n';
import { SITE } from '../lib/site';
import donatorsData from '../data/donators.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const card = SITE.donation.card;
// src/data/donators.json: { "items": [{ "name": "…", "amount": 10000, "message": "…" }] }
const donators = (donatorsData.items as { name: string; amount?: number; message?: string }[]).sort((a, b) => (b.amount ?? 0) - (a.amount ?? 0)).slice(0, 12);
const tile = 'hover-name flex flex-col gap-1.5 rounded-[18px] bg-elev px-5 py-[18px] text-left transition-colors hover:bg-hover';
---

<Base lang={lang} title={t('Жобаны қолдау')} description={t('Qarip — тегін қазақ қаріп қоры. Жобаны дамыту үшін сіздің қолдауыңыз өте маңызды.')}>
  <div class="mx-auto max-w-[1100px]">
    <div class="flex flex-wrap items-start gap-12">
      <div class="min-w-0 flex-[1_1_420px]">
        <p class="eyebrow mb-3">{t('Қолдау')}</p>
        <h1 class="text-[clamp(34px,4.6vw,52px)] leading-[1.05] font-[650] tracking-[-0.04em]">{t('Жобаны қолдап кетіңіз')}</h1>
        <p class="mt-4 max-w-[540px] text-lg leading-normal text-fg-2">{t('Qarip — тегін және жарнамасыз. Жоба сіздің қолдауыңызбен дамиды: жаңа қаріптерге қазақ әріптерін қосамыз, құралдар жасаймыз.')}</p>
      </div>
      {
        card && (
          <div id="donate" class="card card-own sticky top-[calc(var(--header-h)+2rem)] flex w-full flex-col gap-4 !rounded-3xl p-6 max-sm:static sm:max-w-[420px] sm:flex-[1_1_340px]">
            <b class="text-lg font-[650]">{t('Картаға аудару')}</b>
            <div class="note p-[18px]">
              <span class="meta block">{SITE.donation.bank} · {t('Карта нөмірі')}</span>
              <span class="mt-1 mb-2.5 block font-mono text-[22px] font-medium tracking-[0.02em] tabular-nums">{card}</span>
              {SITE.donation.holder && (
                <>
                  <span class="meta block">{t('Алушы')}</span>
                  <span class="mt-0.5 block font-semibold">{SITE.donation.holder}</span>
                </>
              )}
            </div>
            <CopyButton client:idle text={card.replace(/\s/g, '')} label={t('Карта нөмірін көшіру')} done={t('Көшірілді')} className="btn-primary btn-lg rounded-[14px]!" />
            <p class="meta leading-normal">{t('Аударымға пікір жазсаңыз, есіміңізді қолдаушылар тізіміне қосамыз. Сома маңызды емес — кез келген көмек құнды.')}</p>
          </div>
        )
      }
    </div>

    {
      donators.length > 0 && (
        <section class="mt-16">
          <h2 class="title-md mb-1.5">{t('Қолдаушылар')}</h2>
          <p class="sub mb-4">{t('Рақмет — Qarip сіздердің арқаңызда өмір сүріп тұр.')}</p>
          <div class="grid gap-3 sm:grid-cols-[repeat(auto-fill,minmax(260px,1fr))]">
            {donators.map((d) => (
              <figure class="flex flex-col gap-1.5 rounded-[18px] bg-elev px-5 py-[18px]">
                <div class="flex justify-between gap-2.5">
                  <b class="font-semibold">{d.name}</b>
                  {d.amount ? <span class="font-semibold text-accent-ink tabular-nums">{d.amount.toLocaleString('ru-RU')} ₸</span> : null}
                </div>
                {d.message && <blockquote class="text-[15px] break-words whitespace-pre-wrap text-fg-2">«{d.message}»</blockquote>}
              </figure>
            ))}
            {card && (
              <a href="#donate" class="flex flex-col justify-center gap-1 rounded-[18px] px-5 py-[18px] shadow-[inset_0_0_0_1px_var(--line-2)] transition-colors hover:bg-fill">
                <b class="font-semibold">{t('Сіздің есіміңіз осында болады')}</b>
                <span class="text-sm text-fg-3">{t('Аударымға пікір қалдырыңыз')}</span>
              </a>
            )}
          </div>
        </section>
      )
    }

    <section class="mt-16">
      <h2 class="title-md mb-4">{card ? t('Ақшасыз да көмектесуге болады') : t('Қалай көмектесуге болады')}</h2>
      <div class="grid gap-3 sm:grid-cols-[repeat(auto-fit,minmax(240px,1fr))]">
        <ShareButton
          client:idle
          url={SITE.url}
          title="Qarip"
          label={t('Сілтемемен бөлісу')}
          copied={t('Сілтеме көшірілді')}
          hint={t('Достарыңызбен бөлісіңіз — бұл ең үлкен көмек.')}
          className={tile}
        />
        <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class={tile}>
          <b class="font-name">Telegram</b>
          <span class="text-sm text-fg-3">{t('Жаңа қаріптер мен мақалалар алдымен осында шығады.')}</span>
        </a>
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" class={tile}>
          <b class="font-name">Instagram</b>
          <span class="text-sm text-fg-3">{t('Жобаның ішкі жағы мен жаңа қаріптер.')}</span>
        </a>
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Qarip: жаңа қаріп')}`} class={tile}>
          <b class="font-name">{t('Қаріп ұсыну')}</b>
          <span class="text-sm text-fg-3">{t('Қазақ әріптері бар қаріп жасадыңыз ба? Бізге жіберіңіз — қорға қосамыз.')}</span>
        </a>
      </div>
    </section>

    <p class="sub mt-12">
      {t('Қаріпке тапсырыс бергіңіз келе ме?')} <a class="link" href={localePath(lang, '/services')}>{t('Қызметтер')}</a>
    </p>
  </div>
</Base>
